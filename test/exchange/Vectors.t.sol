pragma solidity 0.8.24;

import {Test} from "forge-std/Test.sol";
import {MakoOutcomeExchangeV1 as X} from "../../src/MakoOutcomeExchangeV1.sol";
import {MockUSDC} from "../mocks/TokenMocks.sol";

interface ISafeFactory {
    function createProxyWithNonce(address singleton, bytes memory initializer, uint256 saltNonce)
        external
        returns (address);
}

/// @notice Plan section 4.4 "Test vectors", Solidity half: replays `test/vectors/order-abi.json` (generated by S1's
/// `scripts/vectors.mjs` and copied here UNCHANGED, byte for byte) against MakoOutcomeExchangeV1.
///
/// The exchange is built at the vectors' two addresses with its own constructor (`deployCodeTo`); the Safes are
/// created by the real v1.4.1 factory, whose pinned runtime code (`test/vectors/safe-v1.4.1/*.hex`, the code S1 used)
/// is installed on chain 31337 at the chain-10143 addresses. Every non-registered positive call must settle; every
/// negative must revert with exactly the recorded revert data.
///
/// THE REGISTERED-SIGNER VECTORS (plan 4.5: T2b, regRevoked, regSwapped) are NOT settled: this build has no
/// `setOrderSigner` (plan 10.1, Q10: only if the S1 decision record says the fallback fired). They pin its ABSENCE:
/// the plain 65-byte owner signature of a registered Safe is refused, `BadSignature` of the TAKER (the first party the
/// registered path would have admitted), in each of the three cases.
contract VectorsTest is Test {
    address internal constant SAFE_SINGLETON = 0x41675C099F32341bf84BFc5382aF534df5C7461a;
    address internal constant SAFE_FACTORY = 0x4e1DCf7AD4e460CfD30791CCC4F9c8a4f820ec67;
    address internal constant SAFE_MODULE = 0x75cf11467937ce3F2f357CE24ffc3DBF8fD5c226;
    bytes32 internal constant SAFE_SINGLETON_CODEHASH =
        0x1fe2df852ba3299d6534ef416eefa406e56ced995bca886ab7a553e6d0c5e1c4;

    string internal json;
    MockUSDC internal usd;
    address internal operator = makeAddr("operator");
    address internal treasury = makeAddr("treasury");

    function setUp() public {
        // the Safe contracts of the vectors live at the chain-10143 addresses; install the pinned code on 31337
        if (SAFE_SINGLETON.code.length == 0) {
            if (vm.getChainId() != 31337) {
                vm.skip(true, "needs chain 31337 (forge's default)");
                return;
            }
            vm.etch(SAFE_SINGLETON, _hex("test/vectors/safe-v1.4.1/Safe.hex"));
            vm.etch(SAFE_FACTORY, _hex("test/vectors/safe-v1.4.1/SafeProxyFactory.hex"));
            vm.etch(SAFE_MODULE, _hex("test/vectors/safe-v1.4.1/Safe4337Module.hex"));
        }
        assertEq(SAFE_SINGLETON.codehash, SAFE_SINGLETON_CODEHASH, "the pinned Safe singleton code");
        json = vm.readFile("test/vectors/order-abi.json");
        usd = new MockUSDC();
        _place("testnet");
        _place("otherExchange"); // same chain, another address: the exchange at the first must refuse its orders
        _deploySafes();
        _fund(vm.parseJsonAddress(json, ".domains.testnet.verifyingContract"));
        _fund(vm.parseJsonAddress(json, ".domains.otherExchange.verifyingContract"));
    }

    function _hex(string memory file) private view returns (bytes memory) {
        return vm.parseBytes(vm.trim(vm.readFile(file)));
    }

    /// @dev The exchange at a domain set's verifyingContract, built by its own constructor, with its operator and two
    /// open three-option markets (A = 1, B = 2) as the vectors assume.
    function _place(string memory domainId) internal {
        address at = vm.parseJsonAddress(json, string.concat(".domains.", domainId, ".verifyingContract"));
        deployCodeTo("MakoOutcomeExchangeV1.sol:MakoOutcomeExchangeV1", abi.encode(address(usd), treasury), at);
        X e = X(at);
        assertEq(e.admin(), address(this));
        e.setOperator(operator, true);
        for (uint256 i; i < 2; ++i) {
            uint256 m = e.createMarket(
                3, 700, uint64(block.timestamp + 30 days), uint64(block.timestamp + 31 days), 1e15, bytes32(0)
            );
            assertEq(m, i + 1, "markets A = 1, B = 2 as the vectors assume");
        }
    }

    function _parties() internal view returns (address[] memory ps) {
        string[7] memory eoas = [
            "eoaTaker", "eoaMaker1", "eoaMaker2", "eoaMaker3", "safeOwnerTaker", "safeOwnerMaker1", "safeOwnerStranger"
        ];
        ps = new address[](13);
        for (uint256 i; i < 7; ++i) {
            ps[i] = vm.parseJsonAddress(json, string.concat(".keys.", eoas[i], ".address"));
        }
        string[6] memory safes =
            ["safeTaker", "safeMaker1", "safeRegTaker", "safeRegMaker", "safeRegRevoked", "safeRegSwapped"];
        for (uint256 i; i < 6; ++i) {
            ps[7 + i] = vm.parseJsonAddress(json, string.concat(".safes.", safes[i], ".address"));
        }
    }

    /// @dev Every party: cash for any buy, and complete sets in both markets for any sell.
    function _fund(address at) internal {
        X e = X(at);
        address[] memory ps = _parties();
        for (uint256 i; i < ps.length; ++i) {
            usd.mint(ps[i], 1_000_000e6 + 2_000e6);
            vm.startPrank(ps[i]);
            usd.approve(at, type(uint256).max);
            e.deposit(1_000_000e6 + 2_000e6);
            e.mintSets(1, 1_000e6);
            e.mintSets(2, 1_000e6);
            vm.stopPrank();
        }
    }

    function _deploySafes() internal {
        string[6] memory names =
            ["safeTaker", "safeMaker1", "safeRegTaker", "safeRegMaker", "safeRegRevoked", "safeRegSwapped"];
        for (uint256 i; i < 6; ++i) {
            string memory k = string.concat(".safes.", names[i]);
            address got = ISafeFactory(vm.parseJsonAddress(json, string.concat(k, ".factory")))
                .createProxyWithNonce(
                    vm.parseJsonAddress(json, string.concat(k, ".singleton")),
                    vm.parseJsonBytes(json, string.concat(k, ".initializer")),
                    vm.parseJsonUint(json, string.concat(k, ".saltNonce"))
                );
            assertEq(
                got,
                vm.parseJsonAddress(json, string.concat(k, ".address")),
                "the factory deploys the Safe at the vector's address"
            );
        }
    }

    function _send(string memory base) internal returns (bool ok, bytes memory ret) {
        uint256 chainId = vm.parseJsonUint(json, string.concat(base, ".sendTo.chainId"));
        address to = vm.parseJsonAddress(json, string.concat(base, ".sendTo.exchange"));
        bytes memory data = vm.parseJsonBytes(json, string.concat(base, ".calldata"));
        vm.chainId(chainId);
        vm.prank(operator);
        (ok, ret) = to.call(data);
        vm.chainId(31337);
    }

    /// @dev Count of a JSON array of objects.
    function _count(string memory arr) internal view returns (uint256 n) {
        while (vm.keyExistsJson(json, string.concat(arr, "[", vm.toString(n), "]"))) ++n;
    }

    function _id(string memory base) internal view returns (string memory) {
        return vm.parseJsonString(json, string.concat(base, ".id"));
    }

    function _isRegistered(string memory id) internal pure returns (bool) {
        bytes32 h = keccak256(bytes(id));
        return h == keccak256("regRevoked") || h == keccak256("regSwapped") || _startsWith(id, "T2b@");
    }

    function _startsWith(string memory s, string memory p) internal pure returns (bool) {
        bytes memory a = bytes(s);
        bytes memory b = bytes(p);
        if (a.length < b.length) return false;
        for (uint256 i; i < b.length; ++i) {
            if (a[i] != b[i]) return false;
        }
        return true;
    }

    function test_vectors_fileIsTheSelectorsOfTheCompiledAbi() public view {
        assertEq(vm.parseJsonBytes(json, ".functions.matchOrders.selector"), abi.encodePacked(X.matchOrders.selector));
        assertEq(
            vm.parseJsonBytes(json, ".functions.isValidOrderSignature.selector"),
            abi.encodePacked(X.isValidOrderSignature.selector)
        );
        assertEq(vm.parseJsonBytes(json, ".functions.cancelOrders.selector"), abi.encodePacked(X.cancelOrders.selector));
        assertEq(X.matchOrders.selector, bytes4(0xe4ff4ef4));
        assertEq(X.isValidOrderSignature.selector, bytes4(0x2d075cbf));
        assertEq(X.cancelOrders.selector, bytes4(0x39ccdd5d));
    }

    function test_vectors_domainSeparators() public view {
        string[3] memory ids = ["testnet", "local", "otherExchange"];
        for (uint256 i; i < 3; ++i) {
            string memory k = string.concat(".domains.", ids[i]);
            bytes32 want = vm.parseJsonBytes32(json, string.concat(k, ".separator"));
            bytes32 got = keccak256(
                abi.encode(
                    keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)"),
                    keccak256("Mako Market Exchange"),
                    keccak256("1"),
                    vm.parseJsonUint(json, string.concat(k, ".chainId")),
                    vm.parseJsonAddress(json, string.concat(k, ".verifyingContract"))
                )
            );
            assertEq(got, want, ids[i]);
        }
        assertEq(
            vm.parseJsonBytes32(json, ".types.order.hash"),
            X(vm.parseJsonAddress(json, ".domains.testnet.verifyingContract")).ORDER_TYPEHASH()
        );
        assertEq(
            vm.parseJsonBytes32(json, ".types.eip712Domain.hash"),
            0x8b73c3c69bb8fe3d512ecc4cf759cc79239f7b179b0ffacaa9a75d522b39400f
        );
    }

    function test_vectors_positiveCallsSettle_registeredOnesAreRefused() public {
        uint256 n = _count(".calls");
        assertEq(n, 21);
        uint256 settled;
        uint256 refused;
        for (uint256 i; i < n; ++i) {
            string memory base = string.concat(".calls[", vm.toString(i), "]");
            string memory id = _id(base);
            uint256 snap = vm.snapshotState();
            (bool ok, bytes memory ret) = _send(base);
            if (_isRegistered(id)) {
                // T2b: both parties are registered Safes signing plainly; this build refuses them at the taker
                assertFalse(ok, id);
                string memory taker = vm.parseJsonString(json, string.concat(base, ".taker"));
                bytes32 th = vm.parseJsonBytes32(
                    json,
                    string.concat(
                        ".signed.",
                        vm.parseJsonString(json, string.concat(base, ".signedUnder")),
                        ".",
                        taker,
                        ".orderHash"
                    )
                );
                assertEq(ret, abi.encodeWithSelector(X.BadSignature.selector, th), id);
                ++refused;
            } else {
                if (!ok) emit log_named_bytes(id, ret);
                assertTrue(ok, id);
                ++settled;
            }
            vm.revertToState(snap);
        }
        assertEq(settled, 18);
        assertEq(refused, 3);
    }

    function test_vectors_negativesRevertExactly_registeredOnesAtTheTaker() public {
        uint256 n = _count(".negatives");
        assertEq(n, 26);
        uint256 registered;
        for (uint256 i; i < n; ++i) {
            string memory base = string.concat(".negatives[", vm.toString(i), "]");
            string memory id = _id(base);
            (bool ok, bytes memory ret) = _send(base);
            assertFalse(ok, id);
            if (_isRegistered(id)) {
                // the vector expects the MAKER's BadSignature (the taker passes the registered path); without the path the
                // taker, the first party checked, is the one refused
                string memory taker = vm.parseJsonString(json, string.concat(base, ".taker"));
                bytes32 th = vm.parseJsonBytes32(
                    json,
                    string.concat(
                        ".signed.",
                        vm.parseJsonString(json, string.concat(base, ".signedUnder")),
                        ".",
                        taker,
                        ".orderHash"
                    )
                );
                assertEq(ret, abi.encodeWithSelector(X.BadSignature.selector, th), id);
                ++registered;
            } else {
                assertEq(ret, vm.parseJsonBytes(json, string.concat(base, ".expect.revertData")), id);
            }
        }
        assertEq(registered, 2);
    }

    function test_vectors_errorSelectorsMatchContract() public view {
        string[23] memory names = [
            "NotOperator",
            "Paused",
            "TradingClosed",
            "InsufficientGas",
            "BadSignature",
            "NonceMismatch",
            "OrderCancelled",
            "Expired",
            "Overfill",
            "InsufficientCash",
            "InsufficientShares",
            "PositionCap",
            "PartyRefused",
            "BadSignatureLength",
            "BadOrderField",
            "SelfMatch",
            "PriceNotCrossed",
            "WrongKind",
            "BadMakerCount",
            "LengthMismatch",
            "FillMismatch",
            "SetPriceSum",
            "MarketMismatch"
        ];
        bytes4[23] memory sels = [
            X.NotOperator.selector,
            X.Paused.selector,
            X.TradingClosed.selector,
            X.InsufficientGas.selector,
            X.BadSignature.selector,
            X.NonceMismatch.selector,
            X.OrderCancelled.selector,
            X.Expired.selector,
            X.Overfill.selector,
            X.InsufficientCash.selector,
            X.InsufficientShares.selector,
            X.PositionCap.selector,
            X.PartyRefused.selector,
            X.BadSignatureLength.selector,
            X.BadOrderField.selector,
            X.SelfMatch.selector,
            X.PriceNotCrossed.selector,
            X.WrongKind.selector,
            X.BadMakerCount.selector,
            X.LengthMismatch.selector,
            X.FillMismatch.selector,
            X.SetPriceSum.selector,
            X.MarketMismatch.selector
        ];
        for (uint256 i; i < 23; ++i) {
            assertEq(
                vm.parseJsonBytes(json, string.concat(".errors.", names[i], ".selector")),
                abi.encodePacked(sels[i]),
                names[i]
            );
        }
    }

    /// @dev O2 by chain (plan 10.2): one compiled exchange at the same address on 10143 and on 31337 settles the file's EOA
    /// and Safe orders signed for its own chain and refuses each signed for the other. The positive calls above are sent
    /// under both chain ids ("testnet" and "local" sets); this adds the cross: each set's calldata sent to the wrong chain.
    function test_vectors_O2byChain_eachSetIsRefusedOnTheOtherChain() public {
        uint256 crossed;
        for (uint256 i; i < _count(".calls"); ++i) {
            string memory base = string.concat(".calls[", vm.toString(i), "]");
            string memory id = _id(base);
            if (_isRegistered(id) || _startsWith(id, "T2b")) continue;
            uint256 chainId = vm.parseJsonUint(json, string.concat(base, ".sendTo.chainId"));
            address to = vm.parseJsonAddress(json, string.concat(base, ".sendTo.exchange"));
            bytes memory data = vm.parseJsonBytes(json, string.concat(base, ".calldata"));
            uint256 other = chainId == 10143 ? 31337 : 10143;
            vm.chainId(other);
            vm.prank(operator);
            (bool ok, bytes memory ret) = to.call(data);
            vm.chainId(31337);
            assertFalse(ok, id);
            assertEq(bytes4(ret), X.BadSignature.selector, id);
            ++crossed;
        }
        assertEq(crossed, 18);
    }
}
